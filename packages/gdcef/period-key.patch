diff --git a/gdcef/browser/src/gdbrowser.hpp b/gdcef/browser/src/gdbrowser.hpp
--- a/gdcef/browser/src/gdbrowser.hpp
+++ b/gdcef/browser/src/gdbrowser.hpp
@@ -673,6 +673,20 @@ public:
     //! been loaded in the browser.
     // -------------------------------------------------------------------------
     bool loaded() const;
+
+    // Called from Godot's main thread, which also pumps the CEF UI thread.
+    void setFrameRate(int rate)
+    {
+        if (rate > 0 && m_browser && m_browser->GetHost())
+            m_browser->GetHost()->SetWindowlessFrameRate(rate);
+    }
+
+    int getFrameRate() const
+    {
+        if (!m_browser || !m_browser->GetHost())
+            return 0;
+        return m_browser->GetHost()->GetWindowlessFrameRate();
+    }
 
     // -------------------------------------------------------------------------
     //! \brief Exported method to Godot script. Stop loading the page.
